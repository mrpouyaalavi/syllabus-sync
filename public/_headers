# Cloudflare Workers static-asset headers.
#
# Responses served directly by the assets binding never reach the Next
# middleware, so the security headers set in lib/proxy.ts do not apply to them.
# This file restores the equivalent protection for static files. It is ignored
# by Vercel and by `next start`, where vercel.json / the platform handles it.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Resource-Policy: cross-origin

# Fingerprinted brand and icon assets are safe to cache aggressively.
/brand/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

# The manifest and service worker must revalidate so branding updates land.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
