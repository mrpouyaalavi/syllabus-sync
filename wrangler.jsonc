{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syllabus-sync-production",
  "main": "cloudflare/worker.js",

  // Matches the live Worker exactly. Wrangler config is declarative: lowering
  // this date or dropping a flag would silently change runtime behaviour.
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Cloudflare's native image resizing backs `next/image`. Without this binding
  // every /_next/image request fails and each logo renders broken.
  "images": {
    "binding": "IMAGES"
  },

  // Self-reference binding used by the OpenNext runtime. Present on the live
  // Worker — omitting it here would remove it on the next deploy.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "syllabus-sync-production"
    }
  ],

  // Mirrors the plain-text vars already set on the live Worker. Secrets
  // (CRON_SECRET, SUPABASE_SERVICE_ROLE_KEY, WEBAUTHN_*, RESEND_API_KEY, …)
  // are stored separately and are NOT affected by deploys.
  "vars": {
    "DEPLOYMENT_ENV": "production",
    "DEPLOYMENT_PLATFORM": "cloudflare",
    "NEXT_PUBLIC_APP_URL": "https://www.syllabus-sync.app"
  },

  "observability": {
    "enabled": true
  },

  // The custom domain (www.syllabus-sync.app) is the only intended production
  // origin. workers_dev defaults to enabled when unset — Cloudflare warned
  // about this on the very first deploy of this Worker — which meant
  // syllabus-sync-production.<account>.workers.dev also served live traffic.
  // Verified before disabling: NEXT_PUBLIC_APP_URL, WEBAUTHN_RP_ID and
  // WEBAUTHN_ORIGIN are all scoped to the custom domain, and the OAuth
  // callback URL is built from window.location.origin — so a request that
  // arrives via workers.dev would already fail WebAuthn's strict origin check
  // and, unless Supabase's redirect allowlist was separately configured to
  // include the workers.dev host (nothing in this repo suggests it is), the
  // OAuth exchange too. workers.dev therefore added an unauthenticated-anyway
  // second origin with no functional value. Disabling it is reversible by
  // flipping this back to true.
  "workers_dev": false,

  // The three cleanup jobs. cloudflare/worker.js forwards each schedule to its
  // existing API route, which is why the live Worker reports both a `fetch` and
  // a `scheduled` handler.
  "triggers": {
    "crons": ["0 3 * * *", "10 3 * * *", "20 3 * * *"]
  }

  // The custom domain (www.syllabus-sync.app) is attached to the Worker as a
  // separate resource and is deliberately not declared here — declaring
  // `routes` would take over management of it.
  //
  // verify: 2026-08-08 — no-op change to trigger a real Cloudflare Git build
  // and confirm the dashboard's Workers Builds environment variables
  // (NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, etc.) are
  // actually visible to `next build` there, not just in a local/manual deploy.
}
